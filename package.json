{
  "name": "pixel-art-asset",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "node --experimental-transform-types --test test/unittest/*.test.ts",
    "test:endpoints": "node --experimental-transform-types --test test/integrationtest/endpointDiscovery.test.ts",
    "test:integration": "node --experimental-transform-types --test test/integrationtest/*.test.ts",
    "bulk": "node --experimental-transform-types --no-warnings tools/bulk-test.ts",
    "batch100test": "node --experimental-transform-types --no-warnings test/integrationtest/batch100test.ts",
    "batch:compare": "node --experimental-transform-types --no-warnings test/integrationtest/runComparative.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@google/genai": "^1.29.1",
    "lucide-react": "^0.553.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
